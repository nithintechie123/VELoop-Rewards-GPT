# =============================================================
# VELOOP Rewards - Environment Configuration Template
# NOTE: Never commit sensitive configuration or .env to GitHub.
# Commit this .env.example template instead.
# =============================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL & Allowed CORS Origins
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Authentication Security Secrets
# Use cryptographically random 256-bit or 512-bit hex strings in production
JWT_SECRET=your_super_secure_jwt_access_secret_2026_change_in_production
REFRESH_SECRET=your_super_secure_jwt_refresh_secret_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database Connection (MongoDB Atlas or Self-Hosted URI)
# Standard URI format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/veloop_rewards?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/veloop_rewards
MONGODB_URI=mongodb://127.0.0.1:27017/veloop_rewards
