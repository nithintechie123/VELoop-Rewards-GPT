# =============================================================
# VELOOP Rewards - Frontend (Vite / React) Environment Template
# =============================================================
# CRITICAL SECURITY RULE (Requirement 47):
# NEVER place sensitive credentials inside React/Vite environment variables!
# The browser bundle is completely public. Never place:
#   - MongoDB credentials / connection strings
#   - JWT signing secrets (JWT_SECRET / REFRESH_SECRET)
#   - Admin credentials / passwords
#   - Private API keys / cloud provider credentials
#
# Only non-sensitive public configuration (prefixed with VITE_) is permitted here.
# =============================================================

# Public Backend API Gateway URL (Exposed to the browser)
VITE_API_BASE_URL=http://localhost:5000/api
